generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}
enum OrderStatus {
  PENDING
  CONFIRMED
  DELIVERED
  CANCELLED
}

// Yalnız seçim saxlanır: kart məlumatları (nömrə, CVV) heç vaxt serverə gəlmir və saxlanmır
enum PayMethod {
  CARD
  CASH
}

model User {
  id             Int      @id @default(autoincrement())
  email          String   @unique
  firstName      String   @map("first_name")
  lastName       String   @map("last_name")
  passwordHash   String   @map("password_hash")
  role           Role     @default(USER)
  marketingOptIn Boolean  @default(false) @map("marketing_opt_in")
  createdAt      DateTime @default(now()) @map("created_at")
  cartItems CartItem[]
  wishlists Wishlist[]
  promoRedemptions PromoRedemption[]
  orders Order[]
  reviews Review[]
  reviewVotes ReviewVote[]
  contactMessages ContactMessage[]

  @@map("users")
}

model Book {
  id          Int      @id @default(autoincrement())
  externalId  String?  @unique @map("external_id")
  title       String
  author      String
  description String?
  coverUrl    String?  @map("cover_url")
  year        Int?
  pages       Int?
  subjects    String[]
  priceCents  Int      @map("price_cents")
  stock       Int?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  orderItems    OrderItem[]
  reviews       Review[]

  @@map("books")
}

model CartItem {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  bookId    Int      @map("book_id")
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  // Bir istifadəçinin səbətində eyni kitab yalnız bir sətirdə ola bilər
  @@unique([userId, bookId])
  @@index([userId])
  @@map("cart_items")
}

model Wishlist {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  name      String
  isPublic  Boolean  @default(false) @map("is_public")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WishlistItem[]

  // Bir istifadəçinin iki siyahısı eyni adda ola bilməz
  @@unique([userId, name])
  @@map("wishlists")
}

model WishlistItem {
  id         Int      @id @default(autoincrement())
  wishlistId Int      @map("wishlist_id")
  bookId     Int      @map("book_id")
  createdAt  DateTime @default(now()) @map("created_at")

  wishlist Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  book     Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  // Eyni kitab bir siyahıda yalnız bir dəfə
  @@unique([wishlistId, bookId])
  @@map("wishlist_items")
}

model PromoCode {
  id              Int       @id @default(autoincrement())
  code            String    @unique
  description     String?
  discountPercent Int       @map("discount_percent")
  isActive        Boolean   @default(true) @map("is_active")
  expiresAt       DateTime? @map("expires_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  redemptions PromoRedemption[]
  orders      Order[]

  @@map("promo_codes")
}

// Kim hansı kodu işlədib. (promoCodeId, userId) unikaldır: bir istifadəçi eyni kodu yalnız bir dəfə işlədə bilər.
model PromoRedemption {
  id          Int      @id @default(autoincrement())
  promoCodeId Int      @map("promo_code_id")
  userId      Int      @map("user_id")
  createdAt   DateTime @default(now()) @map("created_at")

  // Restrict: istifadə olunmuş kodu silmək olmaz (tarixçə itməsin)
  promoCode PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Restrict)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([promoCodeId, userId])
  @@index([userId])
  @@map("promo_redemptions")
}

model Order {
  id               Int         @id @default(autoincrement())
  userId           Int         @map("user_id")
  status           OrderStatus @default(PENDING)
  payMethod        PayMethod   @map("pay_method")

  // Pul qəpiklə (integer). Sifariş anındakı hesablama dondurulur: sonra promo/qiymət dəyişsə də köhnə sifariş dəyişmir.
  subtotalCents    Int         @map("subtotal_cents")
  discountCents    Int         @map("discount_cents")
  deliveryFeeCents Int         @map("delivery_fee_cents")
  totalCents       Int         @map("total_cents")

  // Promo: kod mətni və faiz snapshot kimi qalır, promoCodeId isə kod silinərsə null olur
  promoCodeId      Int?        @map("promo_code_id")
  promoCode        String?     @map("promo_code")
  discountPercent  Int?        @map("discount_percent")

  fullName         String      @map("full_name")
  phone            String
  city             String
  street           String
  building         String      @default("")
  apartment        String      @default("")
  deliveryDate     DateTime    @map("delivery_date") @db.Date

  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")
  cancelledAt      DateTime?   @map("cancelled_at")

  // Restrict: sifarişi olan istifadəçi silinə bilməz (tarixçə itməsin)
  user      User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  promo     PromoCode? @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  items     OrderItem[]

  @@index([userId, createdAt])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id             Int     @id @default(autoincrement())
  orderId        Int     @map("order_id")
  bookId         Int     @map("book_id")

  // Snapshot: kitab sonradan dəyişsə də sifarişdə o vaxtkı ad/qiymət qalır
  title          String
  author         String
  coverUrl       String? @map("cover_url")
  unitPriceCents Int     @map("unit_price_cents")
  quantity       Int

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // Restrict: sifarişdə olan kitabı silmək olmaz (409 RELATION_CONFLICT)
  book  Book  @relation(fields: [bookId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("order_items")
}

model Review {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  bookId      Int      @map("book_id")
  rating      Int
  title       String
  body        String
  recommended Boolean
  // "Faydalı oldu?" sayğacları: səs verilərkən yenidən hesablanır (sıralama üçün hər dəfə COUNT etməyək)
  helpfulYes  Int      @default(0) @map("helpful_yes")
  helpfulNo   Int      @default(0) @map("helpful_no")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  book  Book         @relation(fields: [bookId], references: [id], onDelete: Cascade)
  votes ReviewVote[]

  // Bir istifadəçi bir kitaba yalnız bir rəy yaza bilər
  @@unique([userId, bookId])
  @@index([bookId, createdAt])
  @@map("reviews")
}

model ReviewVote {
  id        Int      @id @default(autoincrement())
  reviewId  Int      @map("review_id")
  userId    Int      @map("user_id")
  helpful   Boolean
  createdAt DateTime @default(now()) @map("created_at")

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Bir istifadəçi bir rəyə yalnız bir səs verə bilər
  @@unique([reviewId, userId])
  @@map("review_votes")
}

// "Bizimlə əlaqə" formundan gələn mesajlar. userId yalnız giriş edibsə doldurulur.
model ContactMessage {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  name      String
  email     String
  subject   String
  message   String
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  // SetNull: istifadəçi silinsə mesaj qalır (admin cavab verə bilsin)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([isRead, createdAt])
  @@map("contact_messages")
}

model NewsletterSubscriber {
  id               Int       @id @default(autoincrement())
  email            String    @unique
  isActive         Boolean   @default(true) @map("is_active")
  // Abunəlikdən çıxma linki üçün gizli token (email-dəki linkdə olacaq, API ilə heç kimə göstərilmir)
  unsubscribeToken String    @unique @default(uuid()) @map("unsubscribe_token")
  subscribedAt     DateTime  @default(now()) @map("subscribed_at")
  unsubscribedAt   DateTime? @map("unsubscribed_at")

  @@map("newsletter_subscribers")
}

model GiftCard {
  id           Int       @id @default(autoincrement())
  code         String    @unique
  initialCents Int       @map("initial_cents")
  balanceCents Int       @map("balance_cents")
  isActive     Boolean   @default(true) @map("is_active")
  expiresAt    DateTime? @map("expires_at")
  note         String?
  createdAt    DateTime  @default(now()) @map("created_at")

  @@map("gift_cards")
}